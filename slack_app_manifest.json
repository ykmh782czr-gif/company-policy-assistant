{
  "display_information": {
    "name": "Sara Policy Assistant",
    "description": "Sara Cairati's company policy assignment bot",
    "background_color": "#1b2b45"
  },
  "features": {
    "bot_user": {"display_name": "Sara Policy Assistant", "always_online": false}
  },
  "oauth_config": {
    "scopes": {"bot": ["app_mentions:read", "chat:write"]}
  },
  "settings": {
    "event_subscriptions": {"bot_events": ["app_mention"]},
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
